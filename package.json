{
  "name": "slop-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "dotenv -e .env -e .env.local -- pnpm --dir apps/web dev",
    "dev:web": "dotenv -e .env -e .env.local -- pnpm --dir apps/web dev",
    "dev:mobile": "dotenv -e .env -e .env.local -- pnpm --filter @slopbot/mobile start",
    "dev:desktop": "dotenv -e .env -e .env.local -- node scripts/hutch.mjs run dev",
    "build:desktop": "dotenv -e .env -e .env.local -- node scripts/hutch.mjs electrobun build --env=dev",
    "build": "dotenv -e .env -e .env.local -- pnpm --dir apps/web build",
    "start": "pnpm --dir apps/web start",
    "typecheck": "tsc --noEmit && pnpm --filter @slopbot/contracts typecheck && pnpm --filter @slopbot/mobile typecheck && pnpm --dir apps/desktop typecheck",
    "test": "vitest run",
    "db:migrate": "dotenv -e .env -e .env.local -- tsx db/migrate.ts"
  },
  "dependencies": {
    "@ai-sdk/workflow": "^2.0.97",
    "@base-ui/react": "^1.9.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@phosphor-icons/react": "^2.1.10",
    "@slopbot/contracts": "workspace:*",
    "@slopbot/design-tokens": "workspace:*",
    "@vercel/sandbox": "^3.9.1",
    "@x402/fetch": "^2.30.0",
    "agentmail": "^0.5.53",
    "ai": "^7.0.165",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "drizzle-orm": "^0.45.4",
    "effect": "^4.1.2",
    "jose": "^6.2.15",
    "mem0ai": "^3.3.1",
    "next": "16.4.5",
    "next-themes": "^0.4.6",
    "parallel-web": "^1.3.7",
    "postgres": "^3.4.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "workflow": "^5.4.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.0",
    "@types/node": "24.x",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "dotenv-cli": "^11.1.0",
    "tailwindcss": "4.3.0",
    "tsx": "^4.21.0",
    "typescript": "6.0.3",
    "vitest": "^4.1.0"
  }
}
