{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@db/*": ["../../db/*"],
      "@workflows/*": ["../../workflows/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "../../db/**/*.ts",
    "../../workflows/**/*.ts",
    "../../packages/contracts/src/**/*.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
