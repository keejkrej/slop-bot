{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "es2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowJs": false,
    "noEmit": true,
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "paths": {
      "@/*": ["apps/web/*"],
      "@db/*": ["db/*"],
      "@workflows/*": ["workflows/*"],
      "@slopbot/contracts": ["packages/contracts/src/index.ts"]
    }
  },
  "include": [
    "apps/web/**/*.ts",
    "apps/web/**/*.tsx",
    "packages/contracts/src/**/*.ts",
    "workflows/**/*.ts",
    "db/**/*.ts",
    "next.config.ts",
    "vitest.config.ts"
  ]
}
