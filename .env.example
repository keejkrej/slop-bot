# Public URL used for MCP OAuth callbacks. Use an HTTPS tunnel for phone OAuth locally.
APP_URL=http://localhost:3000

# Vercel AI Gateway. On Vercel, OIDC can authenticate instead.
AI_GATEWAY_API_KEY=

# Production persistence. Without this, local development uses .data/store.json.
DATABASE_URL=
# 32 random bytes, base64 encoded: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Vercel account sign-in (single tenant). Team Settings → Apps.
VERCEL_APP_CLIENT_ID=
VERCEL_APP_CLIENT_SECRET=
BETTER_AUTH_SECRET=
# Vercel user ID allowed to access this deployment (from GET /v2/user).
ALLOWED_USER_ID=

# Optional Composio hosted MCP sessions.
COMPOSIO_API_KEY=

# Electrobun bridge. Use a random token and your Vercel user ID.
DESKTOP_PAIRING_TOKEN=
DESKTOP_USER_ID=

# Android: leave blank for automatic Expo/LAN discovery; use 10.0.2.2 for an emulator if needed.
EXPO_PUBLIC_API_URL=
