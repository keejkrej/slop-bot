# Public URL used for MCP OAuth callbacks. Use an HTTPS tunnel for phone OAuth locally.
APP_URL=http://localhost:3000

# Vercel AI Gateway. On Vercel, OIDC can authenticate instead.
AI_GATEWAY_API_KEY=

# Production persistence. Without this, local development uses .data/store.json.
DATABASE_URL=
# 32 random bytes, base64 encoded: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Optional real user auth. Local development uses a demo user when omitted.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Only this Google account can access the production API.
ALLOWED_EMAIL=you@example.com

# Optional Composio hosted MCP sessions.
COMPOSIO_API_KEY=

# Electrobun bridge. Use a random token and your Supabase auth user UUID.
DESKTOP_PAIRING_TOKEN=
DESKTOP_USER_ID=

# Android: leave blank for automatic Expo/LAN discovery; use 10.0.2.2 for an emulator if needed.
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
